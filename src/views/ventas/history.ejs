<%- include('../partials/header') %>
<% function getMetodoPago(codigo) { 
  switch(codigo) {
    case '1': return 'Efectivo';
    case '2': return 'Yape';
    case '3': return 'Plin';
    case '4': return 'Transferencia';
    case '5': return 'Pago Mixto'; // Add mixed payment
    case '6': return 'Por cobrar';
    default: return 'Desconocido';
  }
} %>
<h1>Historial de Modificaciones - Venta #<%= venta.id_venta %></h1>

<div class="card mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p><strong>Fecha original:</strong> <%= venta.fecha.toLocaleDateString() %></p>
          <p><strong>Vendedor original:</strong> <%= venta.vendedor %></p>
        </div>
        <div class="col-md-6">
          <p><strong>Cliente:</strong> <%= venta.cliente %></p>
          <p><strong>Total original:</strong> S/ <%= venta.total.toFixed(2) %></p>
          <p class="font-weight-bold">
            <strong>Total neto:</strong> 
            <span class="<%= venta.net_total < venta.total ? 'text-danger' : 'text-success' %>">
              S/ <%= venta.net_total.toFixed(2) %>
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>

<h3>Modificaciones</h3>

<!-- Add Export Button -->
<div class="mb-3">
  <a href="/ventas/<%= venta.id_venta %>/historial/exportar" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
  </a>
</div>

<% if (history.length === 0) { %>
  <div class="alert alert-info">No hay modificaciones registradas para esta venta.</div>
<% } else { %>
  <div class="accordion" id="historyAccordion">
    <% history.forEach((mod, index) => { %>
      <div class="card">
        <div class="card-header" id="heading<%= index %>">
          <h2 class="mb-0">
            <button class="btn btn-link btn-block text-left" type="button" data-toggle="collapse" 
            data-target="#collapse<%= index %>" aria-expanded="true" aria-controls="collapse<%= index %>">
      <%= mod.fecha.toLocaleString() %> - 
      <%= mod.empleado %> - 
      <% if (mod.total < 0) { %>
        <span class="text-danger">Devolución: S/ <%= (-mod.total).toFixed(2) %></span>
      <% } else { %>
        <span class="text-success">Modificación: S/ <%= mod.total.toFixed(2) %></span>
      <% } %>
      <small class="text-muted">
        <%= getMetodoPago(mod.mediodepago) %> 
        <% if (mod.mediodepago === '5' && mod.noperacion) { %>
          <% 
          let mixedData = null;
          try {
            mixedData = mod.payment_details ? JSON.parse(mod.payment_details) : null;
          } catch (e) {
            console.error('Error parsing mixed payment data:', e);
          }
        %>
        <% if (mixedData) { %>
          <div class="alert alert-info mb-3">
            <strong>Detalles de Pago Mixto:</strong><br>
            - Efectivo: S/ <%= mixedData.efectivo.toFixed(2) %><br>
            - <%= getMetodoPago(mixedData.metodo_electronico) %>: S/ <%= mixedData.electronico.toFixed(2) %><br>
            <% if (mod.noperacion) { %>
              - N° Operación: <%= mod.noperacion %>
            <% } %>
          </div>
        <% } %>
      <% } %>
      <!-- Show return reason -->
<% if (mod.motivo) { %>
  <div class="alert alert-warning">
    <strong>Motivo de devolución:</strong> <%= mod.motivo %>
  </div>
<% } %>
    </button>
          </h2>
        </div>

        <div id="collapse<%= index %>" class="collapse <%= index === 0 ? 'show' : '' %>" 
             aria-labelledby="heading<%= index %>" data-parent="#historyAccordion">
          <div class="card-body">
            <!-- Payment Method Details -->
            <% if (mod.mediodepago === '5' && mod.noperacion) { %>
              <% 
                let mixedData = null;
                try {
                  mixedData = mod.noperacion ? JSON.parse(mod.noperacion) : null;
                } catch (e) {
                  console.error('Error parsing mixed payment data:', e);
                }
              %>
              <% if (mixedData) { %>
                <div class="alert alert-info mb-3">
                  <strong>Detalles de Pago Mixto:</strong><br>
                  - Efectivo: S/ <%= mixedData.efectivo.toFixed(2) %><br>
                  - <%= getMetodoPago(mixedData.metodo_electronico) %>: S/ <%= mixedData.electronico.toFixed(2) %><br>
                  <% if (mixedData.operacion_electronica) { %>
                    - N° Operación: <%= mixedData.operacion_electronica %>
                  <% } %>
                </div>
              <% } %>
            <% } %>

            <table class="table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Producto</th>
                  <th>Marca</th>
                  <th>Variante</th>
                  <th>Descripción</th>
                  <th>Precio Unitario</th>
                  <th>Cantidad</th>
                  <th>Subtotal</th>
                  <% if (mod.total < 0) { %>
                    <th>Motivo</th> <!-- Add motivo column header -->
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% mod.detalles.forEach(detalle => { %>
                  <tr>
                    <td><%= detalle.id_producto %></td>
                    <td><%= detalle.producto_nombre %></td>
                    <td><%= detalle.marca || 'N/A' %></td>
                    <td><%= detalle.variante || 'N/A' %></td>
                    <td><%= detalle.descripcion || 'N/A' %></td>
                    <td>S/ <%= detalle.precio.toFixed(2) %></td>
                    <td><%= detalle.cantidad %></td>
                    <td>S/ <%= (detalle.precio * detalle.cantidad).toFixed(2) %></td>
                    <% if (mod.total < 0) { %>
                      <td><%= mod.motivo %></td> <!-- Use mod.motivo instead of detalle.motivo -->
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr>
                  <th colspan="7">Total</th>
                  <th>S/ <%= mod.total.toFixed(2) %></th>
                  <% if (mod.total < 0) { %>
                    <th></th>
                  <% } %>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<div class="mt-3">
  <a href="/ventas/<%= venta.id_venta %>" class="btn btn-primary">
    <i class="fas fa-arrow-left"></i> Volver a los detalles
  </a>
</div>
<%- include('../partials/footer') %>