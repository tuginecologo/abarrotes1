<%- include('../partials/header') %>

<h1>Nueva Venta</h1>

<div class="form-group">
  <label for="barcode-scanner">Escáner de Código de Barras (ID Producto):</label>
  <input type="text" class="form-control" id="barcode-scanner" 
         placeholder="Escaneé el código de barras o ingrese el ID del producto" 
         autocomplete="off" style="max-width: 600px;">
  <div>  
    <small class="form-text text-muted">
    Use un escáner de código de barras o ingrese manualmente el ID del producto. Presione Enter después de escanear.
    </small>
  </div>
</div>

<form id="ventaForm" action="/ventas/nueva" method="POST">
  <h3>Productos</h3>
  <div class="row mb-3">
    <div class="col-md-4">
      <label for="productoSelect" class="form-label">Producto</label>
      <select class="form-control" id="productoSelect" style="width: 100%; max-width: 600px;">
        <option value="">Seleccionar producto</option>
        <% options.productos.forEach(producto => { %>
          <% if (producto.cantidad > 0) { %>
            <option value="<%= producto.id_producto %>" 
                    data-precio="<%= producto.precio %>"
                    data-stock="<%= producto.cantidad %>"
                    data-nombre="<%= producto.nombre %>"
                    data-variante="<%= producto.variante || '' %>"
                    data-marca="<%= producto.marca || '' %>"
                    data-descripcion="<%= producto.descripcion || '' %>">
              <%= producto.id_producto %> - <%= producto.nombre %> 
              <% if (producto.variante) { %>| Variante: <%= producto.variante %><% } %>
              <% if (producto.marca) { %>| Marca: <%= producto.marca %><% } %>
              <% if (producto.descripcion) { %>| Desc: <%= producto.descripcion %><% } %>
              (S/ <%= Number(producto.precio).toFixed(2) %>, Stock: <%= producto.cantidad %>)
            </option>
          <% } %>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <label for="productoCantidad" class="form-label">Cantidad</label>
      <input type="number" class="form-control" id="productoCantidad" min="1" value="1" placeholder="Cantidad">
    </div>
    <div class="col-md-3">
      <label for="productoDescuento" class="form-label">Descuento (S/)</label>
      <input type="number" class="form-control" id="productoDescuento" min="0" step="0.01" value="0" placeholder="Descuento (S/)">
      <small class="form-text text-muted">Descuento por producto</small>
    </div>
    <div class="col-md-3 d-flex align-items-end">
      <button type="button" class="btn btn-primary" id="agregarProducto">
        <i class="fas fa-plus"></i> Agregar
      </button>
    </div>
  </div>

  <button type="button" id="refreshStock" class="btn btn-info">
    <i class="fas fa-sync-alt"></i> Actualizar Stock
  </button>

  <table class="table" id="productosTable">
    <thead>
      <tr>
        <th>ID</th>
        <th>Producto</th>
        <th>Marca</th>
        <th>Variante</th>
        <th>Precio Unitario</th>
        <th>Descuento</th>
        <th>Cantidad</th>
        <th>Subtotal</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody></tbody>
    <tfoot>
      <tr>
        <th colspan="7">Total</th>
        <th id="totalVenta">S/ 0.00</th>
        <th></th>
      </tr>
    </tfoot>
  </table>

  <input type="hidden" name="productos" id="productosInput">

  <div class="row">
    <div class="col-md-6">
      <div class="form-group">
        <label for="id_cliente">Cliente</label>
        <select class="form-control" id="id_cliente" name="id_cliente" required>
          <option value="">Seleccionar cliente</option>
          <% options.clientes.forEach(cliente => { %>
            <option value="<%= cliente.id_cliente %>"><%= cliente.id_cliente %> - <%= cliente.nombre %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <label for="dnivend">Vendedor</label>
        <select class="form-control" id="dnivend" name="dnivend" required>
          <option value="">Seleccionar vendedor</option>
          <% options.empleados.forEach(empleado => { %>
            <option value="<%= empleado.dni %>" <%= venta.dnivend === empleado.dni ? 'selected' : '' %>>
              <%= empleado.nombre %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="form-group">
        <label for="fecha">Fecha</label>
        <input type="date" class="form-control" id="fecha" name="fecha" 
               value="<%= new Date().toISOString().split('T')[0] %>" required>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-group">
        <label for="mediodepago">Método de Pago</label>
        <select class="form-control" id="mediodepago" name="mediodepago" required>
          <option value="">Seleccionar método</option>
          <option value="1">Efectivo</option>
          <option value="2">Yape</option>
          <option value="3">Plin</option>
          <option value="4">Transferencia</option>
          <option value="5">Pago Mixto</option>
          <option value="6">Por Pagar (Crédito)</option>
        </select>
      </div>
    </div>
  </div>

  <div id="mixedPaymentGroup" style="display: none;">
    <input type="hidden" name="payment_details" id="payment_details">
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label for="efectivoAmount">Monto en Efectivo (S/)</label>
          <input type="number" class="form-control" id="efectivoAmount" name="efectivoAmount" step="0.01" min="0">
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label for="electronicMethod">Método Electrónico</label>
          <select class="form-control" id="electronicMethod" name="electronicMethod">
            <option value="">Seleccionar método</option>
            <option value="2">Yape</option>
            <option value="3">Plin</option>
            <option value="4">Transferencia</option>
          </select>
        </div>
      </div>
    </div>

    <div class="form-group" id="mixedOperationGroup">
      <label for="electronicOperation">N° Operación Electrónica</label>
      <input type="text" class="form-control" id="electronicOperation" name="electronicOperation">
    </div>

    <div class="form-group">
      <label>Resumen de Pago:</label>
      <div class="alert alert-info" id="paymentSummary">
        Efectivo: S/ 0.00 + Electrónico: S/ 0.00 = Total: S/ 0.00
      </div>
    </div>
  </div>

  <div class="form-group" id="noperacionGroup" style="display: none;">
    <label for="noperacion">Número de Operación</label>
    <input type="text" class="form-control" id="noperacion" name="noperacion">
  </div>

  <button type="submit" class="btn btn-success">
    <i class="fas fa-save"></i> Registrar Venta
  </button>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const barcodeScanner = document.getElementById('barcode-scanner');
  const productoSelect = document.getElementById('productoSelect');
  const cantidadInput = document.getElementById('productoCantidad');
  const descuentoInput = document.getElementById('productoDescuento');
  const mediodepagoSelect = document.getElementById('mediodepago');
  const noperacionInput = document.getElementById('noperacion');
  const efectivoAmount = document.getElementById('efectivoAmount');
  const electronicMethod = document.getElementById('electronicMethod');
  const electronicOperation = document.getElementById('electronicOperation');
  
  barcodeScanner.focus();
  
  const initialPaymentMethod = mediodepagoSelect.value;
  if (initialPaymentMethod !== '2' && initialPaymentMethod !== '3' && initialPaymentMethod !== '4') {
    noperacionInput.removeAttribute('required');
  }
  if (initialPaymentMethod !== '5') {
    efectivoAmount.removeAttribute('required');
    electronicMethod.removeAttribute('required');
    electronicOperation.removeAttribute('required');
  }

  // Barcode scanner
  barcodeScanner.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const productId = this.value.trim();
      if (productId) {
        const options = productoSelect.options;
        let found = false;
        for (let i = 0; i < options.length; i++) {
          if (options[i].value === productId) {
            productoSelect.value = options[i].value;
            found = true;
            agregarProductoAlCarrito();
            break;
          }
        }
        if (!found) {
          alert('No se encontró el producto con ID: ' + productId);
        }
        this.value = '';
        this.focus();
      }
    }
  });

  function agregarProductoAlCarrito() {
    if (!productoSelect.value) {
      alert('Seleccione un producto');
      return;
    }

    const selectedOption = productoSelect.options[productoSelect.selectedIndex];
    const idProducto = productoSelect.value;
    const nombreProducto = selectedOption.dataset.nombre;
    const marca = selectedOption.dataset.marca || 'N/A';
    const variante = selectedOption.dataset.variante || 'N/A';
    const precio = parseFloat(selectedOption.dataset.precio);
    const cantidad = parseInt(cantidadInput.value);
    const stock = parseInt(selectedOption.dataset.stock);
    const descuento = parseFloat(descuentoInput.value) || 0;

    if (cantidad <= 0) {
      alert('La cantidad debe ser mayor a 0');
      return;
    }

    if (cantidad > stock) {
      alert(`No hay suficiente stock. Disponible: ${stock}`);
      return;
    }

    if (descuento > precio) {
      alert(`El descuento (${descuento}) no puede ser mayor al precio (${precio}) del producto`);
      return;
    }

    const precioFinal = precio - descuento;
    const subtotal = precioFinal * cantidad;

    const existingRow = document.querySelector(`#productosTable tr[data-id="${idProducto}"]`);
    if (existingRow) {
      const existingCantidad = parseInt(existingRow.querySelector('.cantidad').textContent);
      const newCantidad = existingCantidad + cantidad;
      if (newCantidad > stock) {
        alert(`No hay suficiente stock para esta cantidad adicional. Disponible: ${stock - existingCantidad}`);
        return;
      }
      existingRow.querySelector('.cantidad').textContent = newCantidad;
      existingRow.querySelector('.subtotal').textContent = `S/ ${(precioFinal * newCantidad).toFixed(2)}`;
    } else {
      const tbody = document.querySelector('#productosTable tbody');
      const row = document.createElement('tr');
      row.dataset.id = idProducto;
      
      row.innerHTML = `
        <td>${idProducto}</td>
        <td>${nombreProducto}</td>
        <td>${marca}</td>
        <td>${variante}</td>
        <td class="precio-original">S/ ${precio.toFixed(2)}</td>
        <td class="descuento">S/ ${descuento.toFixed(2)}</td>
        <td class="cantidad">${cantidad}</td>
        <td class="subtotal">S/ ${subtotal.toFixed(2)}</td>
        <td>
          <button type="button" class="btn btn-sm btn-danger eliminar-producto">
            <i class="fas fa-trash"></i>
          </button>
        </td>
      `;
      
      tbody.appendChild(row);
    }

    actualizarTotal();
    cantidadInput.value = 1;
    descuentoInput.value = 0;
    productoSelect.value = '';
  }

  function updatePaymentSummary() {
    const paymentMethod = mediodepagoSelect.value;
    if (paymentMethod === '5') {
      const efectivoAmountValue = parseFloat(efectivoAmount.value) || 0;
      const total = parseFloat(document.getElementById('totalVenta').textContent.replace('S/ ', ''));
      const electronicAmount = total - efectivoAmountValue;
      document.getElementById('paymentSummary').innerHTML = `
        Efectivo: S/ ${efectivoAmountValue.toFixed(2)} + 
        Electrónico: S/ ${electronicAmount.toFixed(2)} = 
        Total: S/ ${total.toFixed(2)}
      `;
    }
  }

  mediodepagoSelect.addEventListener('change', function() {
    const noperacionGroup = document.getElementById('noperacionGroup');
    const mixedPaymentGroup = document.getElementById('mixedPaymentGroup');
    const isElectronic = (this.value === '2' || this.value === '3' || this.value === '4');
    const isMixed = (this.value === '5');
    
    noperacionGroup.style.display = isElectronic ? 'block' : 'none';
    mixedPaymentGroup.style.display = isMixed ? 'block' : 'none';
    
    if (isElectronic) {
      noperacionInput.setAttribute('required', 'required');
    } else {
      noperacionInput.removeAttribute('required');
      noperacionInput.value = '';
    }
    
    if (isMixed) {
      efectivoAmount.setAttribute('required', 'required');
      electronicMethod.setAttribute('required', 'required');
      electronicOperation.setAttribute('required', 'required');
    } else {
      efectivoAmount.removeAttribute('required');
      electronicMethod.removeAttribute('required');
      electronicOperation.removeAttribute('required');
      efectivoAmount.value = '';
      electronicMethod.value = '';
      electronicOperation.value = '';
    }
    
    if (isMixed) {
      updatePaymentSummary();
    } else {
      document.getElementById('paymentSummary').innerHTML = '';
    }
  });

  electronicMethod.addEventListener('change', function() {
    document.getElementById('mixedOperationGroup').style.display = this.value !== '' ? 'block' : 'none';
  });

  efectivoAmount.addEventListener('input', updatePaymentSummary);
    
  document.getElementById('ventaForm').addEventListener('submit', function(e) {
    const paymentMethod = mediodepagoSelect.value;
    
    const productos = Array.from(document.querySelectorAll('#productosTable tbody tr')).map(row => {
      const precioOriginal = parseFloat(row.querySelector('.precio-original').textContent.replace('S/ ', ''));
      const descuento = parseFloat(row.querySelector('.descuento').textContent.replace('S/ ', ''));
      return {
        id_producto: row.dataset.id,
        nombre: row.querySelector('td:nth-child(2)').textContent,
        cantidad: parseInt(row.querySelector('.cantidad').textContent),
        precio: precioOriginal,
        descuento: descuento
      };
    });

    if (productos.length === 0) {
      e.preventDefault();
      alert('Debe agregar al menos un producto');
      return;
    }

    document.getElementById('productosInput').value = JSON.stringify(productos);

    if (paymentMethod === '2' || paymentMethod === '3' || paymentMethod === '4') {
      if (!noperacionInput.value.trim()) {
        e.preventDefault();
        alert('Debe ingresar el número de operación para pagos electrónicos');
        noperacionInput.focus();
        return;
      }
    }
    
    if (paymentMethod === '5') {
      const efectivoAmountValue = parseFloat(efectivoAmount.value) || 0;
      const electronicMethodValue = electronicMethod.value;
      const electronicOperationValue = electronicOperation.value;
      const total = parseFloat(document.getElementById('totalVenta').textContent.replace('S/ ', ''));
      
      if (!electronicMethodValue) {
        e.preventDefault();
        alert('Debe seleccionar un método electrónico para el pago mixto');
        electronicMethod.focus();
        return;
      }
      if (efectivoAmountValue <= 0) {
        e.preventDefault();
        alert('El monto en efectivo debe ser mayor a 0');
        efectivoAmount.focus();
        return;
      }
      const electronicAmount = total - efectivoAmountValue;
      if (electronicAmount <= 0) {
        e.preventDefault();
        alert('El monto electrónico debe ser mayor a 0. Reduzca el monto en efectivo.');
        efectivoAmount.focus();
        return;
      }
      if (!electronicOperationValue) {
        e.preventDefault();
        alert('Debe ingresar el número de operación para el pago electrónico');
        electronicOperation.focus();
        return;
      }
      
      const mixedPaymentData = {
        efectivo: efectivoAmountValue,
        electronico: electronicAmount,
        metodo_electronico: electronicMethodValue,
        operacion_electronica: electronicOperationValue
      };
      
      document.getElementById('payment_details').value = JSON.stringify(mixedPaymentData);
      document.getElementById('noperacion').value = electronicOperationValue;
    }
  });
  
  document.getElementById('agregarProducto').addEventListener('click', agregarProductoAlCarrito);

  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('eliminar-producto') || e.target.closest('.eliminar-producto')) {
      e.target.closest('tr').remove();
      actualizarTotal();
    }
  });

  function actualizarTotal() {
    const subtotals = Array.from(document.querySelectorAll('.subtotal')).map(el => {
      return parseFloat(el.textContent.replace('S/ ', ''));
    });
    const total = subtotals.reduce((sum, current) => sum + current, 0);
    document.getElementById('totalVenta').textContent = `S/ ${total.toFixed(2)}`;
    
    if (mediodepagoSelect.value === '5') {
      updatePaymentSummary();
    }
  }

  document.getElementById('refreshStock').addEventListener('click', async function() {
    window.location.reload();
  });
});
</script>
<%- include('../partials/footer') %>