<%- include('../partials/header') %>
<% function getMetodoPago(codigo) { 
  switch(codigo) {
    case '1': return 'Efectivo';
    case '2': return 'Yape';
    case '3': return 'Plin';
    case '4': return 'Transferencia';
    case '5': return 'Pago Mixto';
    default: return 'Desconocido';
  }
} %>
<h1>Detalle de Venta #<%= venta.id_venta %></h1>

<div class="card mb-4">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <p><strong>Fecha:</strong> <%= venta.fecha.toLocaleDateString() %></p>
        <p><strong>Vendedor:</strong> <%= venta.vendedor %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Cliente:</strong> <%= venta.cliente %></p>
        <p><strong>Método de Pago:</strong> 
          <% if (venta.mediodepago === '5') { %>
            Pago Mixto
            <% 
              let mixedData = null;
              try {
                mixedData = venta.payment_details ? JSON.parse(venta.payment_details) : null;
              } catch (e) {
                console.error('Error parsing mixed payment data:', e);
              }
            %>
            <% if (mixedData) { %>
              <br>
              <small>
                - Efectivo: S/ <%= mixedData.efectivo.toFixed(2) %><br>
                - <%= getMetodoPago(mixedData.metodo_electronico) %>: S/ <%= mixedData.electronico.toFixed(2) %>
                <% if (venta.noperacion) { %>(Op: <%= venta.noperacion %>)<% } %>
              </small>
            <% } %>
          <% } else { %>
            <%= venta.metodoPago %>
            <% if (venta.noperacion) { %> (Op: <%= venta.noperacion %>) <% } %>
          <% } %>
        </p>
        <!-- Add after payment method display -->
<p><strong>Descuento:</strong> S/ <%= venta.descuento.toFixed(2) %></p>
<p><strong>Total sin descuento:</strong> S/ <%= (venta.total + venta.descuento).toFixed(2) %></p>
        <!-- REMOVE THIS DUPLICATE LINE: <p><strong>N° Operación:</strong> <%= venta.noperacion %></p> -->
      </div>
    </div>
  </div>
</div>

<h3>Productos</h3>
<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Producto</th>
      <th>Marca</th>
      <th>Variante</th>
      <th>Descripción</th>
      <th>Precio Unitario</th>
      <th>Cantidad</th>
      <th>Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% venta.detalles.forEach(detalle => { %>
      <tr>
        <td><%= detalle.id_producto %></td>
        <td><%= detalle.producto_nombre %></td>
        <td><%= detalle.marca || 'N/A' %></td>
        <td><%= detalle.variante || 'N/A' %></td>
        <td><%= detalle.descripcion || 'N/A' %></td>
        <td>S/ <%= detalle.precio.toFixed(2) %></td>
        <td><%= detalle.cantidad %></td>
        <td>S/ <%= (detalle.precio * detalle.cantidad).toFixed(2) %></td>
      </tr>
    <% }) %>
  </tbody>
  <tfoot>
    <tr>
      <th colspan="7">Total</th>
      <th>S/ <%= venta.total.toFixed(2) %></th>
    </tr>
  </tfoot>
</table>

<a href="/ventas" class="btn btn-primary">
  <i class="fas fa-arrow-left"></i> Volver
</a>
<div class="mt-4">
  <div class="row">
    <div class="col-md-6">
      <div class="btn-group">
        <a href="/ventas/<%= venta.id_venta %>/devolver" class="btn btn-warning">
          <i class="fas fa-exchange-alt"></i> Registrar Devolución
        </a>
        <% if (venta.mediodepago !== '1') { %>
          <button class="btn btn-info" disabled>
            Método original: <%= getMetodoPago(venta.mediodepago) %>
            <% if (venta.noperacion) { %> (Op: <%= venta.noperacion %>) <% } %>
          </button>
        <% } %>
      </div>
    </div>
    <div class="col-md-6 text-right">
      <a href="/ventas/<%= venta.id_venta %>/historial" class="btn btn-info">
        <i class="fas fa-history"></i> Ver Historial
      </a>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>