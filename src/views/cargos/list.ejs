<%- include('../partials/header') %>
<h1>Lista de Cargos</h1>

<form action="/cargos" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/cargos/nuevo" class="btn">Nuevo Cargo</a>

<!-- Bulk actions form should only wrap the buttons and checkboxes -->
<!-- <form id="bulk-delete-form" action="/cargos/bulk-delete" method="POST" class="bulk-actions" onsubmit="return validateBulkDelete()"> -->
  <div class="action-buttons">
    <!-- <button type="submit" class="btn-bulk-delete">Eliminar Seleccionados</button> -->
    <a href="/cargos/exportar" class="btn-export">
      <i class="fas fa-file-excel"></i> Exportar a Excel
    </a>
    <a href="/dashboard" class="btn">Volver a Dashboard</a>
  </div>
</form>

<table>
  <thead>
    <tr>
      <!-- <th><input type="checkbox" id="select-all"></th> -->
      <th>ID</th>
      <th>Nombre</th>
      <th>Descripción</th>
      <th>Sueldo (PEN)</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% cargos.forEach(cargo => { %>
      <tr>
        <!-- <td><input type="checkbox" name="cargoIds" value="<%= cargo.id_cargo %>" form="bulk-delete-form"></td> -->
        <td><%= cargo.id_cargo %></td>
        <td><%= cargo.nombre %></td>
        <td><%= cargo.descripcion %></td>
        <td><%= cargo.sueldo.toFixed(2) %></td>
        <td class="actions">
          <a href="/cargos/editar/<%= cargo.id_cargo %>" class="btn-edit">Editar</a>
          <!-- Individual delete form is now outside the bulk form -->
          <form action="/cargos/eliminar/<%= cargo.id_cargo %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-delete" onclick="return confirm('¿Está seguro que desea eliminar este cargo?')">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/cargos?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
    <a href="/cargos?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

