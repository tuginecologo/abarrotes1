<form action="/incidencias" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/incidencias/exportar" class="btn-export">
  <i class="fas fa-file-excel"></i> Exportar a Excel
</a>
<a href="/dashboard" class="btn">Volver a Dashboard</a>

<!-- Add refresh button -->
<a href="/incidencias" class="btn-refresh">
  <i class="fas fa-sync-alt"></i> Actualizar
</a>

<a href="/incidencias/nueva" class="btn btn-primary">
  <i class="fas fa-plus"></i> Nueva Incidencia
</a>

<% if (incidencias.length === 0) { %>
  <div class="alert alert-info mt-3">
    No hay incidencias registradas.
  </div>
<% } else { %>
  <table id="incidencias-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Fecha</th>
        <th>Tipo</th>
        <th>Descripción</th>
        <th>Empleado</th>
        <th>Productos</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% incidencias.forEach(incidencia => { %>
        <tr data-incidencia-id="<%= incidencia.id_incidencia %>">
          <td><%= incidencia.id_incidencia %></td>
          <td><%= new Date(incidencia.fecha).toLocaleDateString() %></td>
          <td>
            <% if (incidencia.tipo === 'daño') { %>
              <span class="badge badge-danger">Daño</span>
            <% } else if (incidencia.tipo === 'pérdida') { %>
              <span class="badge badge-warning">Pérdida</span>
            <% } else { %>
              <span class="badge badge-info">Otros</span>
            <% } %>
          </td>
          <td><%= incidencia.descripcion || 'N/A' %></td>
          <td><%= incidencia.empleado %></td>
          <td><%= incidencia.items_count %></td>
          <td>
            <a href="/incidencias/<%= incidencia.id_incidencia %>" class="btn btn-sm btn-info">
              <i class="fas fa-eye"></i> Ver
            </a>
            <a href="/incidencias/<%= incidencia.id_incidencia %>/editar" class="btn btn-sm btn-warning">
              <i class="fas fa-edit"></i> Editar
            </a>
            <form action="/incidencias/<%= incidencia.id_incidencia %>/eliminar" method="POST" style="display: inline;">
              <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar esta incidencia?')">
                <i class="fas fa-trash"></i> Eliminar
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a href="/incidencias?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
    <% } %>
    <span>Página <%= currentPage %> de <%= totalPages %></span>
    <% if (currentPage < totalPages) { %>
      <a href="/incidencias?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
    <% } %>
  </div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const barcodeScanner = document.getElementById('barcode-scanner');
  const showAllBtn = document.getElementById('show-all-btn');
  const allRows = document.querySelectorAll('#incidencias-table tbody tr');
  
  // Store all incidencias initially
  const allIncidencias = Array.from(allRows);
  
  // Auto-focus on barcode scanner field
  barcodeScanner.focus();

  // Show all incidencias button functionality
  showAllBtn.addEventListener('click', function() {
    // Show all rows
    allRows.forEach(row => {
      row.style.display = '';
    });
    
    // Hide the show all button
    showAllBtn.style.display = 'none';
    
    // Focus back on barcode scanner
    barcodeScanner.focus();
  });

  // Barcode scanner functionality
  barcodeScanner.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const productId = this.value.trim();
      
      if (productId) {
        let found = false;
        
        // Hide all rows first
        allRows.forEach(row => {
          row.style.display = 'none';
        });
        
        // Search for the specific product
        for (let row of allRows) {
          const rowIncidenciaId = row.getAttribute('data-incidencia-id');
          
          if (rowIncidenciaId === productId) {
            // Show only the found incidencia
            row.style.display = '';
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });
            found = true;
            
            // Show the "Show All" button
            showAllBtn.style.display = 'inline-block';
            break;
          }
        }
        
        if (!found) {
          // If not found, show all incidencias and show alert
          allRows.forEach(row => {
            row.style.display = '';
          });
          showAllBtn.style.display = 'none';
          alert('No se encontró la incidencia con ID: ' + productId);
        }
        
        // Clear the field and focus again for next scan
        this.value = '';
        this.focus();
      }
    }
  });

  // Add refresh functionality
  document.querySelector('.btn-refresh').addEventListener('click', function(e) {
    e.preventDefault();
    window.location.reload(true);
  });
});
</script>

<%- include('../partials/footer') %>