<%- include('../partials/header') %>
<h1>Lista de Recepciones</h1>

<form action="/recepciones" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/recepciones/nuevo" class="btn">Nueva Recepción</a>
<a href="/dashboard" class="btn">Volver a Dashboard</a>

<!-- <form id="bulk-delete-form" action="/recepciones/bulk-delete" method="POST" class="bulk-actions" onsubmit="return validateBulkDelete()"> -->
  <div class="action-buttons">
    <!-- <button type="submit" class="btn-bulk-delete">Eliminar Seleccionados</button> -->
    <a href="/recepciones/exportar" class="btn-export">
      <i class="fas fa-file-excel"></i> Exportar a Excel
    </a>
  </div>
</form>

<table>
  <thead>
    <tr>
      <!-- <th><input type="checkbox" id="select-all"></th> -->
      <th>ID Recepción</th>
      <th>ID Producto</th>
      <th>Fecha</th>
      <th>Producto</th>
      <th>Variante</th>
      <th>Marca</th>
      <th>Descripción</th>
      <th>Cantidad</th>
      <th>Proveedor</th>
      <th>Empleado</th>
      <th>Observación</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% recepciones.forEach(recepcion => { %>
      <tr>
        <!-- <td><input type="checkbox" name="recepcionIds" value="<%= recepcion.id_recepcion %>" form="bulk-delete-form"></td> -->
        <td><%= recepcion.id_recepcion %></td>
        <td><%= recepcion.id_producto %></td>
        <td><%= dateFormatter.format(recepcion.fecha) %></td>
        <td><%= recepcion.producto_nombre %></td>
        <td><%= recepcion.producto_variante || '-' %></td>
        <td><%= recepcion.producto_marca || '-' %></td>
        <td><%= recepcion.producto_descripcion || '-' %></td>
        <td><%= recepcion.cantidad %></td>
        <td><%= recepcion.proveedor_nombre %></td>
        <td><%= recepcion.empleado_nombre %></td>
        <td><%= recepcion.observacion || '-' %></td>
        <td class="actions">
          <a href="/recepciones/editar/<%= recepcion.id_recepcion %>" class="btn-edit">Editar</a>
          <form action="/recepciones/eliminar/<%= recepcion.id_recepcion %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-delete" onclick="return confirm('¿Está seguro que desea eliminar esta recepción?')">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/recepciones?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
    <a href="/recepciones?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

<%- include('../partials/footer') %>