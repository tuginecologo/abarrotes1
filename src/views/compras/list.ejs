<%- include('../partials/header') %>
<h1>Lista de Compras</h1>

<form action="/compras" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/compras/nuevo" class="btn">Nueva Compra</a>

<!-- <form id="bulk-delete-form" action="/compras/bulk-delete" method="POST" class="bulk-actions" onsubmit="return validateBulkDelete()"> -->
  <div class="action-buttons">
    <!-- <button type="submit" class="btn-bulk-delete">Eliminar Seleccionados</button> -->
    <a href="/compras/exportar" class="btn-export">
      <i class="fas fa-file-excel"></i> Exportar a Excel
    </a>
    <a href="/dashboard" class="btn">Volver a Dashboard</a>
  </div>
</form>

<table>
  <thead>
    <tr>
      <!-- <th><input type="checkbox" id="select-all"></th> -->
      <th>ID Compra</th>
      <th>ID Producto</th>
      <th>Fecha</th>
      <th>Producto</th>
      <th>Variante</th>
      <th>Marca</th>
      <th>Descripción</th>
      <th>Cantidad</th>
      <th>Precio Unitario</th>
      <th>Total</th>
      <th>Proveedor</th>
      <th>Empleado</th>
      <th>Observación</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% compras.forEach(compra => { 
      const total = compra.cantidad * compra.preciounitario;
    %>
      <tr>
        <!-- <td><input type="checkbox" name="compraIds" value="<%= compra.id_compra %>" form="bulk-delete-form"></td> -->
        <td><%= compra.id_compra %></td>
        <td><%= compra.id_producto %></td>
        <td><%= dateFormatter.format(compra.fecha) %></td>
        <td><%= compra.producto_nombre %></td>
        <td><%= compra.producto_variante || '-' %></td>
        <td><%= compra.producto_marca || '-' %></td>
        <td><%= compra.producto_descripcion || '-' %></td>
        <td><%= compra.cantidad %></td>
        <td>S/ <%= compra.preciounitario.toFixed(2) %></td>
        <td>S/ <%= total.toFixed(2) %></td>
        <td><%= compra.proveedor_nombre %></td>
        <td><%= compra.empleado_nombre %></td>
        <td><%= compra.observacion || '-' %></td>
        <td class="actions">
          <a href="/compras/editar/<%= compra.id_compra %>" class="btn-edit">Editar</a>
          <form action="/compras/eliminar/<%= compra.id_compra %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-delete" onclick="return confirm('¿Está seguro que desea eliminar esta compra?')">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/compras?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
    <a href="/compras?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

