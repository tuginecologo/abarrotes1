<%- include('../partials/header') %>
<% if (!cliente) { %>
    <div class="error">Cliente no encontrado</div>
    <%- include('../partials/footer') %>
    <% return; %>
<% } %>

<h1>Editar Cliente</h1>

<form action="/clientes/editar/<%= cliente.id_cliente %>" method="POST">
  <div class="form-group">
    <label>ID:
      <input type="text" value="<%= cliente.id_cliente %>" readonly disabled>
    </label>
  </div>
  <div class="form-group">
    <label>Nombres:
      <input type="text" name="nombres" value="<%= cliente.nombres %>" required>
    </label>
  </div>
  <div class="form-group">
    <label>Apellidos:
      <input type="text" name="apellidos" value="<%= cliente.apellidos %>" required>
    </label>
  </div>
  <div class="form-group">
    <label>Sexo:
      <select name="sexo" required>
        <option value="M" <%= cliente.sexo === 'M' ? 'selected' : '' %>>Masculino</option>
        <option value="F" <%= cliente.sexo === 'F' ? 'selected' : '' %>>Femenino</option>
      </select>
    </label>
  </div>
  <button type="submit" class="btn">Guardar Cambios</button>
</form>
<%- include('../partials/footer') %>