<%- include('../partials/header') %>
<h1>Lista de Clientes</h1>

<form action="/clientes" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/clientes/nuevo" class="btn">Nuevo Cliente</a>

<!-- <form id="bulk-delete-form" action="/clientes/bulk-delete" method="POST" class="bulk-actions" onsubmit="return validateBulkDelete()"> -->
  <div class="action-buttons">
    <!-- <button type="submit" class="btn-bulk-delete">Eliminar Seleccionados</button> -->
    <a href="/clientes/exportar" class="btn-export">
      <i class="fas fa-file-excel"></i> Exportar a Excel
    </a>
    <a href="/dashboard" class="btn">Volver a Dashboard</a>
  </div>
</form>

<table>
  <thead>
    <tr>
      <!-- <th><input type="checkbox" id="select-all"></th> -->
      <th>DNI</th>
      <th>Nombres</th>
      <th>Apellidos</th>
      <th>Sexo</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% clientes.forEach(cliente => { %>
      <tr>
        <!-- <td><input type="checkbox" name="clienteDnis" value="<%= cliente.dni %>" form="bulk-delete-form"></td> -->
        <td><%= cliente.dni %></td>
        <td><%= cliente.nombres %></td>
        <td><%= cliente.apellidos %></td>
        <td><%= cliente.sexo === 'M' ? 'Masculino' : 'Femenino' %></td>
        <td class="actions">
          <a href="/clientes/editar/<%= cliente.dni %>" class="btn-edit">Editar</a>
          <form action="/clientes/eliminar/<%= cliente.dni %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-delete" onclick="return confirm('¿Está seguro que desea eliminar este cliente?')">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/clientes?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
    <a href="/clientes?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

