<%- include('../partials/header') %>
<h1>Precios</h1>

<!-- Barcode Scanner Field -->
<div class="form-group">
  <label for="barcode-scanner">Escáner de Código de Barras (ID Producto):</label>
  <input type="text" class="form-control" id="barcode-scanner" 
         placeholder="Escaneé el código de barras o ingrese el ID del producto" 
         autocomplete="off" style="max-width: 600px;">
         <div>  
          <small class="form-text text-muted">
          Use un escáner de código de barras o ingrese manualmente el ID del producto. Presione Enter después de escanear.
          </small>
        </div>
      </div>      
</div>

<!-- Mostrar Todos: visible cuando hay búsqueda por ID -->
<% if (idSearch && idSearch.trim() !== '') { %>
  <a href="/precio" class="btn" style="margin-bottom: 15px;">
    <i class="fas fa-eye"></i> Mostrar Todos los Productos
  </a>
<% } %>

<!-- Show All Products button (initially hidden) -->
<button id="show-all-btn" class="btn" style="display: none; margin-bottom: 15px;">
  <i class="fas fa-eye"></i> Mostrar Todos los Productos
</button>

<form action="/precio" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/precio/nuevo" class="btn">Nuevo Precio</a>

<a href="/precio/exportar" class="btn-export">
  <i class="fas fa-file-excel"></i> Exportar a Excel
</a>
<a href="/dashboard" class="btn">Volver a Dashboard</a>

<table id="precios-table">
  <thead>
    <tr>
      <th>ID Producto</th>
      <th>Producto</th>
      <th>Marca</th>
      <th>Descripción</th>
      <th>Variante</th>
      <th>Precio</th>
      <!-- <th>Stock</th> -->
      <th>Acciones</th>
    </tr>
  </thead>
<tbody>
  <% if (notFound) { %>
    <tr>
      <td colspan="7" class="text-center" style="color: #ff6b6b; font-weight: bold;">
        <i class="fas fa-exclamation-triangle"></i> No se encontró ningún producto con el ID: <%= idSearch %>
        <br>
        <small>Verifique que el código de barras sea correcto y que el producto tenga precio registrado.</small>
      </td>
    </tr>
  <% } else if (productos && productos.length > 0) { %>
    <% productos.forEach(producto => { %>
      <tr data-product-id="<%= producto.id_producto %>">
        <td><%= producto.id_producto %></td>
        <td><%= producto.nombre %></td>
        <td><%= producto.marca || '-' %></td>
        <td><%= producto.descripcion || '-' %></td>
        <td><%= producto.variante || '-' %></td>
        <td>S/ <%= producto.precio.toFixed(2) %></td>
        <td class="actions">
          <a href="/precio/editar/<%= producto.id_precio %>" class="btn-edit">Editar Precio</a>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="7" class="text-center">No se encontraron productos con precio registrado</td>
    </tr>
  <% } %>
</tbody>
</table>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/precio?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
    <a href="/precio?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const barcodeScanner = document.getElementById('barcode-scanner');
  const showAllBtn = document.getElementById('show-all-btn');
  const allRows = document.querySelectorAll('#precios-table tbody tr');
  
  // Store all products initially
  const allProducts = Array.from(allRows);
  
  // Auto-focus on barcode scanner field
  barcodeScanner.focus();

  // Show all products button functionality
  showAllBtn.addEventListener('click', function() {
    // Show all rows
    allRows.forEach(row => {
      row.style.display = '';
    });
    
    // Hide the show all button
    showAllBtn.style.display = 'none';
    
    // Focus back on barcode scanner
    barcodeScanner.focus();
  });

  // Barcode scanner functionality
  barcodeScanner.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const productId = this.value.trim();
      
      if (productId) {
        // Redirigir a la misma página pero con el ID como parámetro
        window.location.href = `/precio?id=${encodeURIComponent(productId)}`;
      }
    }
  });
});
</script>

<%- include('../partials/footer') %>