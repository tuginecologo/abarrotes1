<%- include('../partials/header') %>
<h1>Nuevo Precio</h1>

<form action="/precio/nuevo" method="POST">
  <div class="form-group">
    <label>Producto:
      <select name="id_producto" required style="width: 100%; max-width: 600px;">
        <option value="">Seleccione un producto</option>
        <% availableProducts.forEach(producto => { %>
          <option value="<%= producto.id_producto %>">
            <%= producto.id_producto %> - <%= producto.nombre %>
            <% if (producto.variante) { %>| Variante: <%= producto.variante %><% } %>
            <% if (producto.marca) { %>| Marca: <%= producto.marca %><% } %>
            <% if (producto.descripcion) { %>| Desc: <%= producto.descripcion %><% } %>
          </option>
        <% }) %>
      </select>
    </label>
  </div>
  
  <div class="form-group">
    <label>Precio (S/):
      <input type="number" name="precio" min="0.01" step="0.01" required>
    </label>
  </div>
  
  <button type="submit" class="btn">Guardar</button>
</form>

<%- include('../partials/footer') %>