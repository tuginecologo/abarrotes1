<%- include('../partials/header') %>
<% if (!producto) { %>
  <div class="error">Producto no encontrado</div>
  <%- include('../partials/footer') %>
  <% return; %>
<% } %>

<h1>Editar Precio de Producto</h1>

<form action="/precio/editar/<%= producto.id_precio %>" method="POST">
  <div class="form-group">
    <label>Producto:
      <input type="text" value="<%= producto.nombre %>" readonly>
    </label>
  </div>
  
  <div class="form-group">
    <label>Nuevo Precio (S/):
      <input type="number" name="precio" value="<%= producto.precio.toFixed(2) %>" min="0.01" step="0.01" required>
    </label>
  </div>
  
  <button type="submit" class="btn">Actualizar Precio</button>
</form>

<%- include('../partials/footer') %>