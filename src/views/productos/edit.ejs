<%- include('../partials/header') %>
<h1>Editar Producto</h1>

<form action="/productos/editar/<%= product.id_producto %>" method="POST">
  <!-- Add this read-only barcode field -->
  <div class="form-group">
    <label>Código de Barras (ID): 
      <input type="text" value="<%= product.id_producto %>" readonly 
             style="background-color: #f0f0f0; cursor: not-allowed;">
    </label>
  </div>
  
  <div class="form-group">
    <label>Nombre: <input type="text" name="nombre" value="<%= product.nombre %>" required></label>
  </div>
  <div class="form-group">
    <label>Marca: <input type="text" name="marca" value="<%= product.marca %>" required></label>
  </div>
  <div class="form-group">
    <label>Variante: <input type="text" name="variante" value="<%= product.variante %>"></label>
  </div>
  <div class="form-group">
    <label>Descripción: <textarea name="descripcion"><%= product.descripcion %></textarea></label>
  </div>
  <!-- Add this after the cancel button -->
<a href="/productos/media/<%= product.id_producto %>" class="btn">Gestionar Medios</a>
  <button type="submit" class="btn">Guardar Cambios</button>
  <a href="/productos" class="btn-cancel">Cancelar</a>
</form>

<%- include('../partials/footer') %>