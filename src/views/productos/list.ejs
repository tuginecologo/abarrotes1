<%- include('../partials/header') %>
<h1>Lista de Productos</h1>

<!-- Barcode Scanner Field -->
<div class="form-group">
  <label for="barcode-scanner">Escáner de Código de Barras (ID Producto):</label>
  <input type="text" class="form-control" id="barcode-scanner" 
         placeholder="Escaneé el código de barras o ingrese el ID del producto" 
         autocomplete="off" style="max-width: 600px;">
         <div>  
          <small class="form-text text-muted">
          Use un escáner de código de barras o ingrese manualmente el ID del producto. Presione Enter después de escanear.
          </small>
        </div>
      </div>      
</div>

<!-- Show All Products button (initially hidden) -->
<button id="show-all-btn" class="btn" style="display: none; margin-bottom: 15px;">
  <i class="fas fa-eye"></i> Mostrar Todos los Productos
</button>

<!-- Search Form -->
<form action="/productos" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<!-- New Product Button -->
<a href="/productos/nuevo" class="btn">Nuevo Producto</a>
<a href="/dashboard" class="btn">Volver a Dashboard</a>

<!-- <form action="/productos/bulk-delete" method="POST" id="bulkDeleteForm"> -->
  <div class="action-buttons">
    <!-- <button type="submit" class="btn-bulk-delete" onclick="return confirm('¿Está seguro que desea eliminar los productos seleccionados?')"> -->
      <!-- Eliminar Seleccionados -->
    <!-- </button> -->
    <a href="/productos/exportar" class="btn-export">
      <i class="fas fa-file-excel"></i> Exportar a Excel
    </a>
  </div>
  
  <table id="productos-table">
    <thead>
      <tr>
        <!-- <th><input type="checkbox" id="select-all"></th> -->
        <th>ID</th>
        <th>Nombre</th>
        <th>Marca</th>
        <th>Variante</th>
        <th>Descripción</th>
        <th>Fecha</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(product => { %>
        <tr data-product-id="<%= product.id_producto %>">
          <!-- <td><input type="checkbox" name="productIds" value="<%= product.id_producto %>"></td> -->
          <td><%= product.id_producto %></td>
          <td><%= product.nombre %></td>
          <td><%= product.marca %></td>
          <td><%= product.variante %></td>
          <td><%= product.descripcion %></td>
          <td><%= new Date(product.fecha).toLocaleDateString('es-PE') %></td>
          <td class="actions">
            <a href="/productos/editar/<%= product.id_producto %>" class="btn-edit">Editar</a>
            <form action="/productos/eliminar/<%= product.id_producto %>" 
                  method="POST" 
                  onsubmit="return confirm('¿Eliminar este producto?')"
                  style="display:inline;">
              <button type="submit" class="btn-delete">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</form>

<!-- Pagination -->
<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/productos?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  
  <% if (currentPage < totalPages) { %>
    <a href="/productos?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const barcodeScanner = document.getElementById('barcode-scanner');
  const showAllBtn = document.getElementById('show-all-btn');
  const allRows = document.querySelectorAll('#productos-table tbody tr');
  
  // Store all products initially
  const allProducts = Array.from(allRows);
  
  // Auto-focus on barcode scanner field
  barcodeScanner.focus();

  // Show all products button functionality
  showAllBtn.addEventListener('click', function() {
    // Show all rows
    allRows.forEach(row => {
      row.style.display = '';
    });
    
    // Hide the show all button
    showAllBtn.style.display = 'none';
    
    // Focus back on barcode scanner
    barcodeScanner.focus();
  });

  // Barcode scanner functionality
  barcodeScanner.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const productId = this.value.trim();
      
      if (productId) {
        let found = false;
        
        // Hide all rows first
        allRows.forEach(row => {
          row.style.display = 'none';
        });
        
        // Search for the specific product
        for (let row of allRows) {
          const rowProductId = row.getAttribute('data-product-id');
          
          if (rowProductId === productId) {
            // Show only the found product
            row.style.display = '';
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });
            found = true;
            
            // Show the "Show All" button
            showAllBtn.style.display = 'inline-block';
            break;
          }
        }
        
        if (!found) {
          // If not found, show all products and show alert
          allRows.forEach(row => {
            row.style.display = '';
          });
          showAllBtn.style.display = 'none';
          alert('No se encontró el producto con ID: ' + productId);
        }
        
        // Clear the field and focus again for next scan
        this.value = '';
        this.focus();
      }
    }
  });
});
</script>

<%- include('../partials/footer') %>