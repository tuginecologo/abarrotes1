</div>

<!-- Mostrar Todos: visible cuando hay búsqueda por ID -->
<!--<% if (idSearch && idSearch.trim() !== '') { %>
  <a href="/productos" class="btn" style="margin-bottom: 15px;">
    <i class="fas fa-eye"></i> Mostrar Todos los Productos
  </a>
<% } %>
<!-- Search Form -->
<form action="/productos" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<!-- New Product Button -->
<a href="/productos/nuevo" class="btn">Nuevo Producto</a>
<a href="/dashboard" class="btn">Volver a Dashboard</a>

<!-- <form action="/productos/bulk-delete" method="POST" id="bulkDeleteForm"> -->
  <div class="action-buttons">
    <!-- <button type="submit" class="btn-bulk-delete" onclick="return confirm('¿Está seguro que desea eliminar los productos seleccionados?')"> -->
      <!-- Eliminar Seleccionados -->
    <!-- </button> -->
    <a href="/productos/exportar" class="btn-export">
      <i class="fas fa-file-excel"></i> Exportar a Excel
    </a>
  </div>
  
  <table id="productos-table">
    <thead>
      <tr>
        <!-- <th><input type="checkbox" id="select-all"></th> -->
        <th>ID</th>
        <th>Nombre</th>
        <th>Marca</th>
        <th>Variante</th>
        <th>Descripción</th>
        <th>Fecha</th>
        <th>Acciones</th>
      </tr>
    </thead>
<tbody>
  <% if (typeof notFound !== 'undefined' && notFound) { %>
    <tr>
      <td colspan="7" class="text-center" style="color: #ff6b6b; font-weight: bold;">
        <i class="fas fa-exclamation-triangle"></i> No se encontró ningún producto con el ID: <%= idSearch %>
        <br>
        <small>Verifique que el código de barras sea correcto.</small>
      </td>
    </tr>
  <% } else if (products && products.length > 0) { %>
    <% products.forEach(product => { %>
      <tr data-product-id="<%= product.id_producto %>">
        <td><%= product.id_producto %></td>
        <td><%= product.nombre %></td>
        <td><%= product.marca %></td>
        <td><%= product.variante %></td>
        <td><%= product.descripcion %></td>
        <td><%= new Date(product.fecha).toLocaleDateString('es-PE') %></td>
        <td class="actions">
          <a href="/productos/editar/<%= product.id_producto %>" class="btn-edit">Editar</a>
          <form action="/productos/eliminar/<%= product.id_producto %>" 
                method="POST" 
                onsubmit="return confirm('¿Eliminar este producto?')"
                style="display:inline;">
            <button type="submit" class="btn-delete">Eliminar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="7" class="text-center">No se encontraron productos</td>
    </tr>
  <% } %>
</tbody>
  </table>
</form>

<!-- Pagination -->
<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/productos?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  
  <% if (currentPage < totalPages) { %>
    <a href="/productos?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const barcodeScanner = document.getElementById('barcode-scanner');
  
  // Enfocar automáticamente el campo
  if (barcodeScanner) {
    barcodeScanner.focus();

    // Escáner: redirige a la búsqueda por ID
    barcodeScanner.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        const productId = this.value.trim();
        if (productId) {
          window.location.href = `/productos?id=${encodeURIComponent(productId)}`;
        }
      }
    });
  }
});
</script>

<%- include('../partials/footer') %>