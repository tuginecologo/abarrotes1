<%- include('../partials/header') %>
<h1>Editar Empleado</h1>

<form action="/empleados/editar/<%= empleado.dni %>" method="POST" enctype="multipart/form-data">
    <div class="form-group">
        <label>DNI: <input type="text" name="dni" value="<%= empleado.dni %>" readonly></label>
    </div>
    <div class="form-group">
        <label>Nombres: <input type="text" name="nombres" value="<%= empleado.nombres %>" required></label>
    </div>
    <div class="form-group">
        <label>Apellidos: <input type="text" name="apellidos" value="<%= empleado.apellidos %>" required></label>
    </div>
    <div class="form-group">
      <label>Fecha Nacimiento: 
        <input type="date" name="fecnac" 
               value="<%= empleado.fecnac %>" required>
      </label>
    </div>
    <div class="form-group">
        <label>Sexo:
            <select name="sexo" required>
                <option value="M" <%= empleado.sexo === 'M' ? 'selected' : '' %>>Masculino</option>
                <option value="F" <%= empleado.sexo === 'F' ? 'selected' : '' %>>Femenino</option>
            </select>
        </label>
    </div>
    <div class="form-group">
        <label>Cargo:
            <select name="id_cargo" required>
                <% cargos.forEach(cargo => { %>
                    <option value="<%= cargo.id_cargo %>" 
                        <%= cargo.id_cargo === empleado.id_cargo ? 'selected' : '' %>>
                        <%= cargo.nombre %>
                    </option>
                <% }) %>
            </select>
        </label>
    </div>
    <!-- <div class="form-group">
        <label>Imagen:
            <input type="file" name="imagen" accept="image/*">
            <% if (empleado.imagen) { %>
                <div>Imagen actual: <img src="<%= empleado.imagen %>" width="50"></div>
            <% } %>
        </label>
    </div> -->
    <button type="submit" class="btn">Guardar Cambios</button>
  </form>
  

<%- include('../partials/footer') %>