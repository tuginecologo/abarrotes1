<%- include('../partials/header') %>
<h1>Lista de Empleados</h1>

<form action="/empleados" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/empleados/nuevo" class="btn">Nuevo Empleado</a>
<form action="/empleados/bulk-delete" method="POST" id="bulkDeleteForm" enctype="application/x-www-form-urlencoded">
    <div class="action-buttons">
      <!-- <button type="submit" class="btn-bulk-delete">Eliminar Seleccionados</button> -->
      <a href="/empleados/exportar" class="btn-export">
        <i class="fas fa-file-excel"></i> Exportar a Excel
                  <!-- In empleados/list.ejs -->
      </a>
      <a href="/empleados/ex-empleados" class="btn">Ver Ex-Empleados</a>
      <a href="/dashboard" class="btn">Volver a Dashboard</a>
    </div>
</form>

<table>
  <thead>
    <tr>
      <!-- <th></th> -->
      <th>DNI</th>
      <th>Nombres</th>
      <th>Apellidos</th>
      <th>Fecha Nac.</th>
      <th>Sexo</th>
      <th>Cargo</th>
      <th>Fecha Inicio</th>
      <!-- <th>Imagen</th> -->
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% empleados.forEach(empleado => { %>
      <tr>
        <!-- <td><input type="checkbox" name="empleadoIds" value="<%= empleado.dni %>"></td> -->
        <td><%= empleado.dni %></td>
        <td><%= empleado.nombres %></td>
        <td><%= empleado.apellidos %></td>
        <td><%= formatDate(empleado.fecnac) %></td>
        <td><%= empleado.sexo === 'M' ? 'Masculino' : 'Femenino' %></td>
        <td><%= empleado.cargo_nombre %></td>
        <td><%= formatDate(empleado.fecini) %></td>
        <!-- <td>
          <img src="/uploads/empleados/empleado_<%= empleado.dni %>.jpg" 
               onerror="this.src='/images/no-image.png'; this.onerror=null" 
               class="thumbnail"
               onclick="expandImage(this.src, '<%= empleado.nombres %>')">
        </td> -->
        <td class="actions">
          <form>
          <a href="/empleados/editar/<%= empleado.dni %>" class="btn-edit">Editar</a>
          <a href="/empleados/terminar/<%= empleado.dni %>" class="btn-delete">Dar de Baja</a>

          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

