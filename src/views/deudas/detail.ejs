<%- include('../partials/header') %>
<h1>Detalle de Deuda - <%= cliente.nombres %> <%= cliente.apellidos %></h1>

<div class="card">
  <div class="card-body">
    <p><strong>ID Cliente:</strong> <%= cliente.id_cliente %></p>
    <p><strong>Deuda Actual:</strong> S/ <%= Number(deuda).toFixed(2) %></p>
    <p><strong>Total Pagado:</strong> S/ <%= pagos.reduce((sum, p) => sum + p.monto_pago, 0).toFixed(2) %></p>
  </div>
</div>

<h3>Historial de Pagos</h3>
<table class="table">
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Monto</th>
      <th>Observación</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% if (pagos.length === 0) { %>
      <tr><td colspan="4">No hay pagos registrados.</td></tr>
    <% } else { %>
      <% pagos.forEach(pago => { %>
        <tr>
          <td><%= pago.fecha_pago.toLocaleDateString('es-PE') %></td>
          <td>S/ <%= pago.monto_pago.toFixed(2) %></td>
          <td><%= pago.observacion || '-' %></td>
          <td>
            <form action="/deudas/pagar/revertir/<%= pago.id_pago %>" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de revertir este pago? La deuda se restituirá.')">
                <i class="fas fa-undo"></i> Deshacer
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<div class="mt-3">
  <a href="/deudas" class="btn btn-primary">Volver a Deudas</a>
  <a href="/deudas/pagar/<%= cliente.id_cliente %>" class="btn btn-success">Registrar Pago</a>
</div>
<%- include('../partials/footer') %>