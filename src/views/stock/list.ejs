<%- include('../partials/header') %>
<h1>Inventario de Stock</h1>

<meta http-equiv="refresh" content="30">

<!-- Barcode Scanner Field -->
<div class="form-group">
  <label for="barcode-scanner">Escáner de Código de Barras (ID Producto):</label>
  <input type="text" class="form-control" id="barcode-scanner" 
         placeholder="Escaneé el código de barras o ingrese el ID del producto" 
         autocomplete="off" style="max-width: 600px;">
<div>
  <small class="form-text text-muted">
  
    Use un escáner de código de barras o ingrese manualmente el ID del producto. Presione Enter después de escanear.
  </small>
</div>
</div>

<!-- Mostrar Todos: visible cuando hay búsqueda por ID -->
<% if (idSearch && idSearch.trim() !== '') { %>
  <a href="/stock" class="btn" style="margin-bottom: 15px;">
    <i class="fas fa-eye"></i> Mostrar Todos los Productos
  </a>
<% } %>

<form action="/stock" method="GET" class="search-form">
  <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar...">
  <button type="submit">Buscar</button>
</form>

<a href="/stock/exportar" class="btn-export">
  <i class="fas fa-file-excel"></i> Exportar a Excel
</a>
<a href="/dashboard" class="btn">Volver a Dashboard</a>

<!-- Add refresh button -->
<a href="/stock" class="btn-refresh">
  <i class="fas fa-sync-alt"></i> Actualizar
</a>

<!-- Show All Products button (initially hidden) -->
<button id="show-all-btn" class="btn" style="display: none; margin-bottom: 15px;">
  <i class="fas fa-eye"></i> Mostrar Todos los Productos
</button>

<table id="stock-table">
  <thead>
    <tr>
      <th>ID Producto</th>
      <th>Producto</th>
      <th>Marca</th>
      <th>Descripción</th>
      <th>Variante</th>
      <th>Cantidad</th>
      <th>Precio (S/)</th>
      <th>Estado</th>
    </tr>
  </thead>
<tbody>
  <% if (typeof notFound !== 'undefined' && notFound) { %>
    <tr>
      <td colspan="8" class="text-center" style="color: #ff6b6b; font-weight: bold;">
        <i class="fas fa-exclamation-triangle"></i> No se encontró ningún producto con el ID: <%= idSearch %>
        <br>
        <small>Verifique que el código de barras sea correcto.</small>
      </td>
    </tr>
  <% } else if (stock && stock.length > 0) { %>
    <% stock.forEach(item => { %>
      <tr data-product-id="<%= item.id_producto %>">
        <td><%= item.id_producto %></td>
        <td><%= item.producto_nombre %></td>
        <td><%= item.marca || '-' %></td>
        <td><%= item.descripcion || '-' %></td>
        <td><%= item.variante || '-' %></td>
        <td><%= item.cantidad %></td>
        <td>
          <% if (item.precio_publico) { %>
            S/ <%= item.precio_publico.toFixed(2) %>
          <% } else { %>
            -
          <% } %>
        </td>
        <td>
          <% if (item.cantidad <= 0) { %>
            <span class="badge badge-danger">Agotado</span>
          <% } else if (item.cantidad <= 10) { %>
            <span class="badge badge-warning">Bajo Stock</span>
          <% } else { %>
            <span class="badge badge-success">Disponible</span>
          <% } %>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="8" class="text-center">No se encontraron productos en el inventario</td>
    </tr>
  <% } %>
</tbody>
</table>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/stock?page=<%= currentPage - 1 %>&q=<%= searchQuery %>" class="page-link">Anterior</a>
  <% } %>
  <span>Página <%= currentPage %> de <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
    <a href="/stock?page=<%= currentPage + 1 %>&q=<%= searchQuery %>" class="page-link">Siguiente</a>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const barcodeScanner = document.getElementById('barcode-scanner');
  const showAllBtn = document.getElementById('show-all-btn');
  const allRows = document.querySelectorAll('#stock-table tbody tr');
  
  // Store all products initially
  const allProducts = Array.from(allRows);
  
  // Auto-focus on barcode scanner field
  barcodeScanner.focus();

  // Show all products button functionality
  showAllBtn.addEventListener('click', function() {
    // Show all rows
    allRows.forEach(row => {
      row.style.display = '';
    });
    
    // Hide the show all button
    showAllBtn.style.display = 'none';
    
    // Focus back on barcode scanner
    barcodeScanner.focus();
  });

  // Barcode scanner functionality
  barcodeScanner.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const productId = this.value.trim();
      
if (productId) {
        window.location.href = `/stock?id=${encodeURIComponent(productId)}`;
      }
    }
  });

  // Add manual refresh capability
  document.querySelector('.btn-refresh').addEventListener('click', function(e) {
    e.preventDefault();
    window.location.reload(true);
  });
});
</script>

<%- include('../partials/footer') %>