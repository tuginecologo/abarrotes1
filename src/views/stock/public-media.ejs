<%- include('../partials/header') %>
<h1>Medios para: <%= product.nombre %></h1>

<div class="media-container">
  <div class="images-section">
    <h2>Imágenes del Producto</h2>
    <% if (images.length > 0) { %>
      <div class="image-gallery">
        <% images.forEach(image => { %>
          <div class="image-item">
            <img src="/uploads/productos/<%= image.imagen_path %>" alt="Imagen del producto" class="modal-image" data-src="/uploads/productos/<%= image.imagen_path %>">
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No hay imágenes para este producto.</p>
    <% } %>
  </div>

  <div class="videos-section">
    <h2>Videos del Producto</h2>
    <% if (videos.length > 0) { %>
      <div class="video-list">
        <% videos.forEach(video => { %>
          <div class="video-item">
            <a href="<%= video.video_url %>" target="_blank" class="video-link"><%= video.video_url %></a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No hay videos para este producto.</p>
    <% } %>
  </div>
</div>

<!-- Modal for image preview -->
<div id="imageModal" class="modal">
  <span class="close">&times;</span>
  <img class="modal-content" id="modalImage">
</div>

<a href="/public/stock" class="btn">Volver al Inventario</a>
<a href="/" class="btn">Volver al Inicio</a>

<script>
  // Wait for DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', function() {
    // Get the modal
    const modal = document.getElementById("imageModal");
    
    // Get the image and insert it inside the modal
    const modalImg = document.getElementById("modalImage");
    
    // Get the <span> element that closes the modal
    const span = document.getElementsByClassName("close")[0];
    
    // Get all modal images
    const modalImages = document.getElementsByClassName("modal-image");
    
    // Add click event to all modal images
    for (let i = 0; i < modalImages.length; i++) {
      modalImages[i].onclick = function() {
        modal.style.display = "block";
        modalImg.src = this.getAttribute('data-src');
        
        // Add loading class while image loads
        modalImg.classList.add('image-loading');
        
        // Remove loading class when image is loaded
        modalImg.onload = function() {
          modalImg.classList.remove('image-loading');
        };
      };
    }
    
    // When the user clicks on <span> (x), close the modal
    span.onclick = function() {
      modal.style.display = "none";
    };
    
    // When the user clicks anywhere outside of the modal, close it
    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    };
    
    // Close modal with ESC key
    document.addEventListener('keydown', function(event) {
      if (event.key === "Escape") {
        modal.style.display = "none";
      }
    });
  });
</script>

<%- include('../partials/footer') %>